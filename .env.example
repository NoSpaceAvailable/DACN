# Default offline (no LLM) mode
VAPT_SAFE_MODE=true

# Ollama backend (set when --llm ollama:<model> is used).
# OLLAMA_BASE_URL points at the Caddy reverse proxy on the VPS; do NOT include /api/...
OLLAMA_BASE_URL=http://157.245.195.74
OLLAMA_TOKEN=replace-with-real-bearer-token
# Per-call timeout in seconds. CPU inference for 5B+ models is slow (~3 tok/s);
# 600s is safe for recon-style prompts (~500-token output). Bump higher if you
# see OllamaError "timed out" or HTTP 502 from the Caddy proxy.
OLLAMA_TIMEOUT=600
